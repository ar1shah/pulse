PI_HOST=pulse@pulse.local

# sim | live | replay
PULSE_SOURCE=sim
# demo | random (sim only)
SIM_SCENARIO=demo

# Sensor serial ports on the Pi: UART0 (pins 8/10) and UART3 (pins 7/29, dtoverlay=uart3), found in ARI-2.
LD2450_PORT=/dev/ttyAMA0
C1001_PORT=/dev/ttyAMA3

# LD2450 x filter (pi/pulse/tracker.py). Blank = on for live, off for sim. 0 = off (pre-filter fusion), 1 = on.
PULSE_XFILTER=
# 1 = log raw LD2450 slots vs shown dots to recordings/xlog_<time>.csv (plot: tools/plot_x.py). Blank = off.
LOG_RAW=

# Replay mode (ALEX-3): recorded .jsonl files. Blank = recordings/sample_*.jsonl.
REPLAY_LD2450=
REPLAY_C1001=

# Sitrep (ALEX-4). Blank = template sitrep and browser speech. Never commit real keys.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
