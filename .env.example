PI_HOST=pulse@pulse.local

# sim | live | replay. Blank = sim on a Mac, live on the Pi.
PULSE_SOURCE=
# demo | random (sim only)
SIM_SCENARIO=demo

# Sensor serial ports on the Pi.
LD2450_PORT=/dev/ttyAMA0
# PLACEHOLDER: not confirmed. Replace with the device name recorded in BRINGUP stage 2 (T9).
C1001_PORT=/dev/ttyAMA3

# S6 only. Leave blank to get the template sitrep and browser speech. Never commit real keys.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
