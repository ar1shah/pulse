PI_HOST=pulse@pulse.local

# sim | live | replay
PULSE_SOURCE=sim
# demo | random (sim only)
SIM_SCENARIO=demo

# Sensor serial ports on the Pi. C1001_PORT is filled in during Phase 3 (ARI-2 finds the UART3 device).
LD2450_PORT=/dev/ttyAMA0
C1001_PORT=

# Replay mode (ALEX-3): recorded .jsonl files. Blank = recordings/sample_*.jsonl.
REPLAY_LD2450=
REPLAY_C1001=

# Sitrep (ALEX-4). Blank = template sitrep and browser speech. Never commit real keys.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
